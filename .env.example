# Repo-root env file consumed by docker-compose.yml.
# All of this should come from 1Password
#
# Copy to `.env` (gitignored) and fill in values for any service you opt into.

# Cloudflare Tunnel — only required when running `docker compose --profile tunnel up`.
# Get from Cloudflare Zero Trust dashboard → Networks → Tunnels → <your tunnel> → Connectors.
CLOUDFLARE_TUNNEL_TOKEN=
