# Repo-root env file consumed by docker-compose.yml.
#
# `.env` is the LOCAL CACHE — 1Password is the source of truth for
# every value below. To populate from your local 1Password vault:
#
#   op signin              # one-time sign-in
#   rando secrets sync     # pulls each var from the `local` vault
#                          # (see DEVELOPER_SETUP.md → "1Password integration")
#
# You can also paste values manually if you opt out of 1Password
# (`rando init --no-1password`). Each block below documents where the
# upstream value comes from in case you're populating items in the
# vault for the first time.

# Cloudflare Tunnel — only required when running `docker compose --profile tunnel up`.
# Get from Cloudflare Zero Trust dashboard → Networks → Tunnels → <your tunnel> → Connectors.
CLOUDFLARE_TUNNEL_TOKEN=

# `rando` CLI — only required to run `pnpm rando` infrastructure commands.
# See INFRASTRUCTURE.md and packages/cli/README.md.
NEON_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# `rando issues` — issue-tracker integration (ticket lookup, lifecycle
# transitions, commit hook, CI sync). The active tracker is picked by
# `tracker.kind` in rando.config.json — fill in the vars for whichever
# you're using.
#
# GitHub Issues (default): a fine-grained PAT with read+write on the
# target repo's Issues. Or run `gh auth token` to grab the current one
# from the gh CLI.
GITHUB_TOKEN=
#
# Jira Cloud (when tracker.kind = "jira"): token from
# id.atlassian.com → Security → API tokens.
JIRA_BASE_URL=https://your-workspace.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# `rando api postman sync` — Postman workspace integration. Only
# required if you want to sync the OpenAPI spec into Postman. Generate
# at https://web.postman.co/settings/me/api-keys.
POSTMAN_API_KEY=

# PostGIS-backed @rando/db tests — only required to run packages/db tests.
# Default below works against the docker-compose Postgres after a one-time
# `docker exec rando-postgres psql -U rando -d postgres -c "CREATE DATABASE rando_test;"`
# Skipped silently when unset; CI sets this to the right value.
DATABASE_URL_TEST=postgres://rando:rando@localhost:5432/rando_test
