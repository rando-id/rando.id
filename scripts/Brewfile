# Brewfile — system-level dependencies for Rando.id development.
#
# Install or sync with:
#   brew bundle install
#
# Verify what's missing without installing:
#   brew bundle check
#
# `rando doctor` runs `brew bundle check` automatically when a Brewfile
# is present. `rando init` will offer to run `brew bundle install` for
# any missing entries on first-clone bootstrap.

# ── Core dev toolchain ────────────────────────────────────────────────
brew "gh"               # GitHub CLI — used by `rando issues` orchestrators + PR ops
brew "pnpm"             # workspace tooling
brew "node@22"          # Node 22+ required by the CLI bin shebang
brew "1password-cli"    # `op` — managing tokens in 1Password (per .env.example comment)

# ── DB tooling ────────────────────────────────────────────────────────
brew "postgresql@16"    # pg_dump / pg_restore for `rando db copy`; version matches Neon

# ── Local infra ───────────────────────────────────────────────────────
brew "cloudflared"      # Cloudflare Tunnel — used by `rando dev` for the public dev URL

# ── Container runtime — pick whichever you prefer ─────────────────────
# OrbStack is the lighter-weight default. Swap for `cask "docker"` if
# you prefer Docker Desktop. Either provides the `docker` CLI that
# `rando dev` (Postgres + tunnel) needs.
cask "orbstack"
