# dependencies
node_modules/
.pnp.*
.yarn/
.pnpm-store/

# build output
.next/
out/
dist/
build/
.turbo/
.tamagui/
apps/*/public/tamagui.css
.expo/
.expo-shared/

# native
ios/
android/
*.xcworkspace
*.xcodeproj

# env
.env
.env.local
.env.*.local
# `op run` env files — per-developer vault references, copied from .op.env.example
.op.env
**/.op.env
# `op plugin init` per-project credential bindings — your PAT lives in YOUR vault,
# so the references in here aren't shareable. Each dev runs the init themselves.
.op/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.log

# editors / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# testing
coverage/
playwright-report/
test-results/

# typescript
*.tsbuildinfo

# misc
.cache/
.eslintcache

# claude code (user-local permissions + session state)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# brew bundle install generates this — versions float, no value in committing
Brewfile.lock.json

# Rendered OpenAPI spec — generated by `pnpm spec:lint:static`.
# Not committed; the canonical spec is served live from /v1/openapi.json
# and the contract is the source of truth.
apps/api/.openapi-rendered.json
