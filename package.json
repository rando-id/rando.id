{
  "name": "rando",
  "version": "0.0.0",
  "private": true,
  "description": "Rando.id — location-based contacts app",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  },
  "pnpm": {
    "overrides": {
      "react-native-reanimated": "~4.3.1",
      "react-native-worklets": "~0.8.3",
      "@types/react": "^19.0.0"
    }
  }
}
