{
  "name": "@rando/brand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/assets.ts",
    "./assets/*": "./assets/*",
    "./colors": "./src/colors.ts"
  },
