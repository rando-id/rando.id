{
  "name": "@rando/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./themes": "./src/themes/index.ts",
    "./env": "./src/env.ts",
    "./feature-flags": "./src/feature-flags.ts",
    "./rando-config": "./src/rando-config.ts"
  },
  "scripts": {
