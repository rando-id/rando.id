{
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Vercel Protection Bypass header. Lets CI reach preview deploys",
          "// that Vercel's Deployment Protection would otherwise 302 to",
          "// vercel.com/sso-api on every request. The `vercelBypass` env var",
          "// is populated from VERCEL_AUTOMATION_BYPASS_SECRET in CI; locally",
          "// it's empty and the empty-value header is a no-op (localhost",
          "// ignores it; Vercel ignores empty bypass values). See",
          "// .notes/ci-vercel-protection-bypass.spec.md.",
          "const bypass = pm.environment.get('vercelBypass') || pm.variables.get('vercelBypass') || '';",
          "if (bypass) {",
          "  pm.request.headers.upsert({ key: 'x-vercel-protection-bypass', value: bypass });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Liveness check",
      "request": {
        "name": "Liveness check",
        "description": {
          "content": "Public, unauthenticated. Returns service identity + timestamp.",
          "type": "text/plain"
        },
        "url": {
          "path": ["v1", "health"],
          "host": ["{{baseUrl}}"],
          "query": [],
          "variable": []
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "method": "GET",
        "body": {},
        "auth": null
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('responds 200', () => pm.response.to.have.status(200));",
              "pm.test('reports the service identity + timestamp', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('ok', true);",
              "  pm.expect(body).to.have.property('service');",
              "  pm.expect(body).to.have.property('timestamp');",
              "});"
            ]
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      }
    },
