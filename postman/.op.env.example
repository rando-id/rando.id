# Template for `op run` — 1Password CLI injects secrets at runtime so
# `pnpm test:api` can authenticate without ever writing tokens to disk.
#
# Usage:
#   cp postman/.op.env.example postman/.op.env
#   # edit references below to point at YOUR 1Password vault + item paths
#   op signin   # if you haven't recently
#   op run --env-file=postman/.op.env -- pnpm test:api
#
# Reference format is `op://<vault>/<item>/<field>` — copy from 1Password
# desktop app (right-click an item → Copy Secret Reference) or build
# by hand. Pointers themselves aren't secrets, but `.op.env` is
# gitignored so per-developer vault names don't end up in the repo.
#
# Without `op run` the token is just empty and the auth-required tests
# in the Postman collection assert "rejected" (current behavior). With
# it, future tests that hit authed endpoints will pick the token up.

AUTH_TOKEN=op://Rando/api-dev-token/credential
